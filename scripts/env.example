# Greek ERP/CRM Environment Configuration
# Copy this file to .env in each service directory and configure your values

# ==============================================
# CORE APPLICATION SETTINGS
# ==============================================
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=your-super-secret-key-change-this-in-production
LOG_LEVEL=INFO

# ==============================================
# DATABASE CONFIGURATION
# ==============================================
# Master database for company management
DATABASE_URL=postgresql://username:password@localhost:5432/greek_erp_master

# Database connection pool settings
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30

# ==============================================
# JWT AUTHENTICATION
# ==============================================
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ==============================================
# CORS AND SECURITY
# ==============================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:3003,http://localhost:3004
ALLOWED_HOSTS=localhost,127.0.0.1

# ==============================================
# GREEK BUSINESS CONFIGURATION
# ==============================================
DEFAULT_VAT_RATE=0.24
REDUCED_VAT_RATE_1=0.13
REDUCED_VAT_RATE_2=0.06
ZERO_VAT_RATE=0.00
GREEK_CURRENCY=EUR
GREEK_LOCALE=el_GR
DEFAULT_TIMEZONE=Europe/Athens

# ==============================================
# AADE (GREEK TAX AUTHORITY) INTEGRATION
# ==============================================
AADE_BASE_URL=https://mydata-dev.azure-api.net
AADE_SUBSCRIPTION_KEY=your-aade-subscription-key
AADE_TIMEOUT_SECONDS=30
AADE_ENABLE_SANDBOX=true

# ==============================================
# FILE STORAGE
# ==============================================
FILE_STORAGE_PATH=./storage/files
MAX_FILE_SIZE_MB=50
ALLOWED_FILE_EXTENSIONS=.pdf,.jpg,.jpeg,.png,.doc,.docx,.xls,.xlsx

# ==============================================
# EMAIL CONFIGURATION
# ==============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-email-password
SMTP_USE_TLS=true

# ==============================================
# AI SERVICES
# ==============================================
OPENAI_API_KEY=your-openai-api-key

# ==============================================
# SERVICE COMMUNICATION
# ==============================================
API_SERVICE_URL=http://localhost:8000
AUTH_SERVICE_URL=http://localhost:8001
FILES_SERVICE_URL=http://localhost:8002
INTEGRATIONS_SERVICE_URL=http://localhost:8003
VOICE_SERVICE_URL=http://localhost:8004
AI_SUPPORT_SERVICE_URL=http://localhost:8005 