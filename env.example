# Placeholder configuration for an isolated local development database.
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
DATABASE_URL=
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=30
SECRET_KEY=
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
ALLOWED_HOSTS=localhost,127.0.0.1
DEFAULT_TIMEZONE=Europe/Athens
DEFAULT_LANGUAGE=el
DEFAULT_CURRENCY=EUR
# Optional integrations: configure privately only when needed.
AADE_ENABLE_SANDBOX=true
AADE_SUBSCRIPTION_KEY=
SMTP_HOST=
SMTP_USERNAME=
SMTP_PASSWORD=

# Private local database configuration used by setup utilities.
DB_NAME=
DB_USER=
DB_PASSWORD=
# Private administrator password used only when creating an administrator.
SUPERUSER_PASSWORD=
